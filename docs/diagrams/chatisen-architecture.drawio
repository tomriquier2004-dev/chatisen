ze:11.5px&quot; color=&quot;#374151&quot;&gt;+UUID id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+String refreshTokenHash&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+UUID familyId&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+Date expiresAt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+Date revokedAt&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+rotate() : Session&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+revoke()&lt;/font&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#E8F0FE;strokeColor=#1a73e8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="230" height="160" as="geometry"/></mxCell><mxCell id="uident" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1f2937&quot;&gt;UserIdentity&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+String provider&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+String subject&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+Date createdAt&lt;/font&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#E8F0FE;strokeColor=#1a73e8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="230" height="86" as="geometry"/></mxCell><mxCell id="turn" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b7280&quot;&gt;&amp;laquo;value object&amp;raquo;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1f2937&quot;&gt;TurnCredentials&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+String username&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+String credential&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+List urls&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+int ttlSeconds&lt;/font&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#F3F4F6;strokeColor=#6b7280;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="230" height="118" as="geometry"/></mxCell><mxCell id="e1l" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;possède&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="168" width="70" height="16" as="geometry"/></mxCell><mxCell id="e1a" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1f2937&quot;&gt;1&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="289" y="193" width="14" height="16" as="geometry"/></mxCell><mxCell id="e1b" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1f2937&quot;&gt;0..*&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="358" y="171" width="33" height="16" as="geometry"/></mxCell><mxCell id="e2l" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;est lié à&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="342" y="318" width="60" height="16" as="geometry"/></mxCell><mxCell id="e2a" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1f2937&quot;&gt;1&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="289" y="263" width="14" height="16" as="geometry"/></mxCell><mxCell id="e2b" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1f2937&quot;&gt;0..*&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="358" y="386" width="33" height="16" as="geometry"/></mxCell><mxCell id="e3l" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;obtient&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="163" y="352" width="56" height="16" as="geometry"/></mxCell><mxCell id="n1" value="&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#1f2937&quot;&gt;Règles du domaine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#1f2937&quot;&gt;• passwordHash est NULL pour un compte créé par Microsoft ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#1f2937&quot;&gt;   l'identité est retrouvée par (provider, subject) = (microsoft, tid:oid).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#1f2937&quot;&gt;• Une session appartient à une famille de refresh tokens : la réutilisation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#1f2937&quot;&gt;   d'un jeton déjà tourné révoque toute la famille.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#1f2937&quot;&gt;• TurnCredentials n'est pas stocké : username = expiration:userId,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#1f2937&quot;&gt;   credential = HMAC-SHA1(secret partagé, username).&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="590" height="250" as="geometry"/></mxCell><mxCell id="member" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1f2937&quot;&gt;ConversationMember&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+MemberRole role&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+int lastReadSeq&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+Date joinedAt&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+markRead(seq)&lt;/font&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#E8F0FE;strokeColor=#1a73e8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="690" y="130" width="240" height="112" as="geometry"/></mxCell><mxCell id="conv" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1f2937&quot;&gt;Conversation&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+UUID id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+ConversationType type&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#374151&quot;&gt;+String title&lt;/font&gt;&lt;br&gt;
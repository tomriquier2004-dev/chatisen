="170" as="geometry"/></mxCell><mxCell id="legend" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#374151&quot;&gt;Légende : vert = chiffré (TLS, SSH, DTLS) · rouge = en clair · gris = déploiement · trait plein = existe · tireté = cible, pas encore déployé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#374151&quot;&gt;Fxx = numéro du flux (docs/architecture.md § 8.3). Le média des appels passe d'abord en direct entre navigateurs (F25) ; TURN ne sert qu'en secours.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FAFAFA;strokeColor=#d1d5db;strokeWidth=1.5;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="1240" width="1860" height="70" as="geometry"/></mxCell><mxCell id="l1" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;HTTPS 443&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;TURN 3478&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="288" y="186" width="104" height="28" as="geometry"/></mxCell><mxCell id="l2" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;HTTPS 443&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;TURN 3478&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="288" y="316" width="104" height="28" as="geometry"/></mxCell><mxCell id="l3" value="&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;HTTP-01&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#1f2937&quot;&gt;port 80&lt;/font&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" 
{
  "components": {
    "schemas": {
      "AuthProviders": {
        "additionalProperties": false,
        "properties": {
          "microsoft": {
            "type": "boolean"
          },
          "password": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "password",
          "microsoft"
        ],
        "type": "object"
      },
      "AuthResponse": {
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "minimum": 1,
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "USERNAME_TAKEN",
                  "EMAIL_TAKEN",
                  "INVALID_CREDENTIALS",
                  "CONVERSATION_FORBIDDEN",
                  "ALREADY_MEMBER",
                  "NOT_A_GROUP",
                  "RATE_LIMITED",
                  "CALL_NOT_FOUND",
                  "CALL_NOT_ACTIVE",
                  "CALL_BUSY",
                  "CALL_ALREADY_ENDED",
                  "INTERNAL_ERROR"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "email"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },

                  "samples": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "bitrateKbps": {
                          "maximum": 100000,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "candidateType": {
                          "enum": [
                            "host",
                            "srflx",
                            "relay"
                          ],
                          "type": "string"
                        },
                        "jitterMs": {

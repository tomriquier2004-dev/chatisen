                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erreur au format unique (FR-18)"
          }
        },
        "summary": "Envoi groupé de mesures de qualité par un participant actif",
        "tags": [
          "calls"
        ],
        "x-requirements": [
          "FR-13",
          "NFR-04"
        ]
      }
    },

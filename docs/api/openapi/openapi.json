{
  "components": {
    "schemas": {
      "AuthProviders": {
        "additionalProperties": false,
        "properties": {
          "microsoft": {
            "type": "boolean"
          },
          "password": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "password",
          "microsoft"
        ],
        "type": "object"
      },
      "AuthResponse": {
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "minimum": 1,
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ],
        "type": "object"
      },
      "ConversationView": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "id": {
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "lastMessage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Message"
              },
              {
                "nullable": true
              }
            ]
          },
          "lastReadSeq": {
            "minimum": 0,
            "type": "integer"
          },
          "lastSeq": {
            "minimum": 0,
            "type": "integer"
          },
          "members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "role": {
                  "enum": [
                    "owner",
                    "admin",
                    "member"
                  ],
                  "type": "string"
                },
                "user": {
                  "$ref": "#/components/schemas/PublicUser"
                }
              },
              "required": [
                "user",
                "role"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "nullable": true
              }
            ]
          },
          "type": {
            "enum": [
              "private",
              "group"
            ],
            "type": "string"
          },
          "unreadCount": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "members",
          "lastSeq",
          "lastReadSeq",
          "unreadCount",
          "lastMessage",
          "createdAt"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "USERNAME_TAKEN",
                  "EMAIL_TAKEN",
                  "INVALID_CREDENTIALS",
                  "CONVERSATION_FORBIDDEN",
                  "ALREADY_MEMBER",
                  "NOT_A_GROUP",
                  "RATE_LIMITED",
                  "CALL_NOT_FOUND",
                  "CALL_NOT_ACTIVE",
                  "CALL_BUSY",
                  "CALL_ALREADY_ENDED",
                  "INTERNAL_ERROR"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HealthLiveResponse": {
        "additionalProperties": false,
        "properties": {

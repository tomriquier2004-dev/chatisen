                        "jitterMs",
                        "packetLossPct",
                        "bitrateKbps",
                        "candidateType"
                      ],
                      "type": "object"
                    },
                    "maxItems": 60,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "samples"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "accepted": {
                      "maximum": 60,

                          "minimum": 0,
                          "type": "number"
                        },
                        "observedAt": {
                          "maxLength": 40,
                          "minLength": 20,
                          "type": "string"
                        },
                        "packetLossPct": {
                          "maximum": 100,
                          "minimum": 0,
                          "type": "number"
                        },
                        "rttMs": {
                          "maximum": 300000,
                          "minimum": 0,
                          "type": "number"
                        }
                      },
                      "required": [

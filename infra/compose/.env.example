# Copier vers infra/compose/.env sur la VM (non versionné) et le protéger : chmod 600 .env
# Aucune vraie valeur ici. Voir infra/README.md, section « Déployer le squelette ».

# Nom d'hôte du site. Le DNS doit déjà pointer vers l'IP de la VM (sinon Caddy n'obtient pas de certificat).
SITE_ADDRESS=dc-ops.isen.fedyna.fr

# Images publiées par la CI dans GHCR. IMAGE_TAG : « sha-<12 premiers caractères du commit> » (déploiement
# reproductible). Obligatoire, sans valeur par défaut : « main » est un tag mobile, à ne pas utiliser en production.
IMAGE_REGISTRY=ghcr.io/tomriquier2004-dev/chatisen
IMAGE_TAG=

# --- PostgreSQL --- mot de passe SANS caractère spécial (il est placé dans une URL) : openssl rand -hex 24
POSTGRES_DB=chatisen
POSTGRES_USER=chatisen
POSTGRES_PASSWORD=

# --- API --- openssl rand -base64 48 (32 caractères minimum)
JWT_SECRET=
LOG_LEVEL=info
# true par défaut : le client est servi en HTTPS. Mettre false seulement pour un essai local en HTTP (SITE_ADDRESS=:80).
COOKIE_SECURE=true

# --- Sauvegardes --- clé PUBLIQUE age (age1…) : la clé privée n'est JAMAIS sur le serveur.
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=7

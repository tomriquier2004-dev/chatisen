# Copier vers .env (non versionné). Aucune vraie valeur ici.
# Les variables seront ajoutées au fil des phases.

# --- PostgreSQL ---
POSTGRES_DB=chatisen
POSTGRES_USER=chatisen
POSTGRES_PASSWORD=change-me

# --- Sauvegarde PostgreSQL (infra/backup, runbook : docs/report/12-…) ---
# Clé PUBLIQUE age (age1…) : chiffre les sauvegardes. La clé privée n'est JAMAIS sur le serveur.
BACKUP_AGE_RECIPIENT=
# Intervalle entre deux sauvegardes, en secondes (21600 = 6 h, c'est aussi la perte de données maximale).
BACKUP_INTERVAL_SECONDS=21600
# Sauvegardes plus anciennes supprimées après ce nombre de jours.
BACKUP_RETENTION_DAYS=7

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Obligatoire en production. En développement, défaut : base de infra/compose/compose.dev.yml (pnpm db:up).
DATABASE_URL=postgres://chatisen:change-me@127.0.0.1:5432/chatisen
DATABASE_POOL_SIZE=10
# Obligatoire en production (32 caractères minimum) : openssl rand -base64 48. En dev, tirée au hasard à chaque démarrage.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Adapter Socket.IO entre instances. Obligatoire dès 2 instances. En dev, défaut : Redis de compose.dev.yml.
REDIS_URL=redis://127.0.0.1:6379
# Limitation de débit sur /auth/* et /users (issue #71). Ne désactiver que pour des tests.
RATE_LIMIT_ENABLED=true
# true uniquement derrière le reverse proxy (Caddy) : adresse client lue dans X-Forwarded-For.
TRUST_PROXY=false
# Attribut Secure du cookie de refresh. Vide = activé partout sauf NODE_ENV=development/test sur une adresse locale.
COOKIE_SECURE=
# --- coturn REST (use-auth-secret) ---
# Secret partagé avec coturn, généré hors dépôt (openssl rand -base64 48). Jamais transmis au client.
TURN_SHARED_SECRET=
# URLs STUN/TURN séparées par des virgules, sans username ni credential.
TURN_URLS=
# Durée des identifiants temporaires, en secondes (60 à 86400 ; défaut 3600).
TURN_CREDENTIAL_TTL_SECONDS=3600
# Délai de sonnerie avant timeout (5 à 120 s ; défaut 30 s).
CALL_RING_TIMEOUT_SECONDS=30
# Délai de grâce après la dernière socket d'un participant (3 à 60 s ; défaut 10 s).
CALL_DISCONNECT_GRACE_SECONDS=10
